# Configuração do PostgreSQL
# TROQUE os valores CHANGE_ME por segredos fortes (ex.: openssl rand -base64 24).
# Em senhas com caracteres especiais (@ : / %), use a forma URL-encoded na DATABASE_URL.
POSTGRES_USER=politica_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=politica_db
POSTGRES_PORT=5432
POSTGRES_SERVER=localhost

# URL de Conexão com o Banco de Dados (desenvolvimento local)
DATABASE_URL=postgresql://politica_user:CHANGE_ME@localhost:5432/politica_db

# Modo SSL da conexão com o banco: disable | require | verify-full
# Docker Compose (Postgres interno, sem TLS): disable. Bancos gerenciados (Supabase, Neon, RDS): require.
DB_SSLMODE=disable

# API Backend
ENVIRONMENT=development
API_PORT=8000

# Limites e proteção da API
RATE_LIMIT_PER_MINUTE=120
# Atrás de proxy reverso confiável, habilite para usar X-Forwarded-For no rate limit
TRUST_PROXY_HEADERS=false
# Token exigido no header X-Admin-Token para force_refresh em /cidadania/consultas (vazio = desabilitado)
ADMIN_REFRESH_TOKEN=
# CORS: regex das origens permitidas (padrão: deploys do projeto na Vercel)
# CORS_ORIGIN_REGEX=^https://legisdata(-[a-z0-9-]+)?\.vercel\.app$
