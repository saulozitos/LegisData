# Configuração do PostgreSQL
POSTGRES_USER=politica_user
# OBRIGATÓRIA: troque por uma senha forte (ex.: `openssl rand -base64 32`).
# O docker-compose não sobe sem ela e a API recusa iniciar em produção sem senha.
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=politica_db
POSTGRES_PORT=5432
POSTGRES_SERVER=localhost

# URL de Conexão com o Banco de Dados (opcional: se omitida, é montada a partir das variáveis acima)
# Mantenha a senha coerente com POSTGRES_PASSWORD.
DATABASE_URL=postgresql://politica_user:troque-esta-senha@localhost:5432/politica_db

# Pool de conexões por worker (total = workers * (pool + overflow) < max_connections do Postgres)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# API Backend
ENVIRONMENT=development
API_PORT=8000

# CORS: origens permitidas (separadas por vírgula), além de localhost:3000/3001
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Regex opcional de origens extras (vazio = desabilitado). Restrinja ao seu projeto, ex.:
# CORS_ORIGIN_REGEX=^https://legisdata(-[a-z0-9-]+)?\.vercel\.app$
CORS_ORIGIN_REGEX=

# Documentação interativa (/docs, /redoc, openapi.json): desabilitada em produção por padrão
ENABLE_DOCS=false

# Token opcional para forçar renovação de caches (header X-Admin-Token). Vazio = desabilitado.
ADMIN_TOKEN=
