[flake8]
max-line-length = 120
extend-ignore = E203, W503, E501
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    env,
    node_modules,
    .next,
    build,
    dist,
    etl/data

per-file-ignores =
    __init__.py: F401
    backend/app/models/*: F821, F401
    backend/app/schemas/*: F401
